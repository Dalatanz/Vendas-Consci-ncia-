# Copie para .env (nunca commite .env com segredos reais)

# Postgres — Supabase (pooler 6543) ou conexão direta 5432 para migrate local
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# JWT — mínimo 16 caracteres; use valor aleatório longo em produção
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria-em-producao"

# URL pública do site (sem barra final) — obrigatório para link de recuperação de senha
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend — https://resend.com (envio de e-mail "esqueci minha senha")
RESEND_API_KEY=""
# Remetente: em testes use onboarding@resend.dev; em produção use domínio verificado
EMAIL_FROM="onboarding@resend.dev"

# Trilha — Google Drive (opcional): 7 IDs na ordem módulo 1→7 = Intro, Aula 01 … Aula 06.
# Último pode ser trocado pelo ID da Aula 07. IDs: .../file/d/ESTE_ID/view
