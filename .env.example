# Copie para .env (nunca commite .env com segredos reais)

# Postgres — Supabase (pooler 6543) ou conexão direta 5432 para migrate local
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# JWT — mínimo 16 caracteres; use valor aleatório longo em produção
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria-em-producao"

# URL pública do site (sem barra final) — obrigatório para link de recuperação de senha
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend — https://resend.com (envio de e-mail "esqueci minha senha")
RESEND_API_KEY=""
# Remetente: em testes use onboarding@resend.dev; em produção use domínio verificado
EMAIL_FROM="onboarding@resend.dev"

# Trilha — vídeos no Google Drive (opcional): 7 IDs de arquivo na ordem dos módulos 1→7.
# Cada ID é o trecho em https://drive.google.com/file/d/SEU_ID/view da pasta compartilhada.
# Ex.: Introducao + Aulas 01–06 (ou ajuste a ordem no seu conteúdo).
# DRIVE_MODULE_VIDEO_IDS="id_intro,id_aula01,id_aula02,id_aula03,id_aula04,id_aula05,id_aula06"
