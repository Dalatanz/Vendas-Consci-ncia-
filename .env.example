# Local (Docker) — ver docker-compose.yml
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uvc"

# Supabase — use a URI do painel (Direct para prisma db push no PC; Pooler na Vercel)
# Documentação: https://supabase.com/docs/guides/database/connecting-to-postgres
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria-em-producao-min-16-chars"
